{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "hugmesh-owncast-bff-api",
    "description" : "Owncast BFF API (/bff/owncast/**) — the broadcast governance plane for the Owncast live-streaming optional service. PR2 owns the owncast_grant grant/timeout/ban overlay (cloned from wiki_access): DEFAULT-DENY broadcast enforced at request time by OwncastBroadcastGuard (an active broadcast grant AND NOT an active ban, precedence ban>grant, SUPERADMIN exempt). Grant/timeout/ban/restore gated OWNCAST_GOVERN (admin|superadmin); list-all/history gated OWNCAST_MANAGE (superadmin). All surfaces are domain-scoped per multi-brand: a scoped ADMIN governs only own-brand streamers. The per-streamer Owncast media instances (RTMP/HLS) are SEPARATE Deployments, not this BFF.",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "Owncast Broadcast Access",
    "description" : "Owncast broadcast grant/timeout/ban overlay (owncast_grant): grant/timeout/ban/restore (OWNCAST_GOVERN), list-all/history (OWNCAST_MANAGE). Domain-scoped; broadcast is DEFAULT-DENY, enforced at request time by OwncastBroadcastGuard (an active grant AND NOT an active ban, SUPERADMIN exempt)."
  }, {
    "name" : "Owncast Moderation",
    "description" : "Owncast moderation surface (/bff/owncast/mod): list a brand's streams (with each owner's active-ban flag), hide (force internal), kill/ban (owncast_grant banned + hide), restore (lift the ban). MOD|ADMIN|SUPERADMIN; authority is the MOD role + domain match, NOT ownership. Domain + moderator identity server-derived from the JWT; ban/restore reuse owncast_grant; kill/hide/ban/restore ONLY (no grant/govern path)."
  }, {
    "name" : "Owncast Stream (self)",
    "description" : "A streamer's OWN stream + self-visibility (owncast_stream): get/upsert title+description, flip visibility internal<->public. Owner + brand server-derived from the JWT. A PUBLIC flip is gated server-side on an active broadcast grant (OwncastBroadcastGuard); ROLE_OWNCAST floor."
  } ],
  "paths" : {
    "/bff/owncast/user/stream" : {
      "get" : {
        "tags" : [ "Owncast Stream (self)" ],
        "summary" : "Get the CALLING streamer's OWN stream (owner == JWT subject, brand server-derived). 404 if the streamer has no stream yet.",
        "operationId" : "getMyStream",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Stream"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "Owncast Stream (self)" ],
        "summary" : "Create-or-update the CALLING streamer's OWN stream title + description. A first upsert creates the stream visibility=internal (fail-closed); visibility is changed only via the visibility endpoint. Owner + brand server-derived.",
        "operationId" : "upsertMyStream",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Upsert"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Stream"
                }
              }
            }
          }
        }
      }
    },
    "/bff/owncast/user/stream/visibility" : {
      "put" : {
        "tags" : [ "Owncast Stream (self)" ],
        "summary" : "Flip the CALLING streamer's OWN stream visibility to 'public' or 'internal'. A flip to PUBLIC is ALLOWED ONLY when the owner currently holds an active broadcast grant (403 otherwise; SUPERADMIN exempt); a flip to INTERNAL is always allowed. 404 if the streamer has no stream yet. Owner + brand server-derived.",
        "operationId" : "setMyStreamVisibility",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Visibility"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Stream"
                }
              }
            }
          }
        }
      }
    },
    "/bff/owncast/mod/streams/{ownerSubject}/restore" : {
      "post" : {
        "tags" : [ "Owncast Moderation" ],
        "summary" : "RESTORE a target owner: CAS the active broadcast ban active->revoked (the row is retained = audit). Does NOT auto-republish — the owner re-chooses visibility. MOD|ADMIN|SUPERADMIN.",
        "operationId" : "restoreStream",
        "parameters" : [ {
          "name" : "ownerSubject",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ModAction"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/bff/owncast/mod/streams/{ownerSubject}/hide" : {
      "post" : {
        "tags" : [ "Owncast Moderation" ],
        "summary" : "HIDE a target owner's stream: force visibility=internal in the moderator's brand (authority = MOD role + domain match, NOT ownership). 404 if the target has no stream in this brand. MOD|ADMIN|SUPERADMIN.",
        "operationId" : "hideStream",
        "parameters" : [ {
          "name" : "ownerSubject",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ModAction"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/bff/owncast/mod/streams/{ownerSubject}/ban" : {
      "post" : {
        "tags" : [ "Owncast Moderation" ],
        "summary" : "KILL a target owner's stream: write owncast_grant(banned) active (the existing OwncastBroadcastGuard ban>grant then blocks the owner's public broadcast) AND force the stream internal. Audit-preserving (never hard-delete). MOD|ADMIN|SUPERADMIN.",
        "operationId" : "banStream",
        "parameters" : [ {
          "name" : "ownerSubject",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ModAction"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/bff/owncast/admin/access/timeout" : {
      "post" : {
        "tags" : [ "Owncast Broadcast Access" ],
        "summary" : "TIMEOUT a USER from broadcast for a bounded window (an active banned override with a future expires_at; auto-restores on expiry). ADMIN/SUPERADMIN, own-brand.",
        "operationId" : "timeoutBroadcast",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Timeout"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Access"
                }
              }
            }
          }
        }
      }
    },
    "/bff/owncast/admin/access/grant" : {
      "post" : {
        "tags" : [ "Owncast Broadcast Access" ],
        "summary" : "GRANT a USER permanent may-broadcast access (an active owncast_grant broadcast override) — the ONLY way to confer broadcast (default-deny). ADMIN/SUPERADMIN, own-brand.",
