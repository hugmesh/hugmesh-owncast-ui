      "get" : {
        "tags" : [ "Owncast Broadcast Access" ],
        "summary" : "List all ACTIVE owncast_grant overrides (scoped to the caller's brand; SUPERADMIN sees all). SUPERADMIN.",
        "operationId" : "listActiveBroadcastAccess",
