    "/bff/owncast/admin/access/{accessType}/{userSubject}" : {
      "delete" : {
        "tags" : [ "Owncast Broadcast Access" ],
        "summary" : "RESTORE/REVOKE: lift the active override of a type for a user (CAS active->revoked; the row is retained = audit). accessType = broadcast|banned: revoke 'banned' to restore broadcast; revoke 'broadcast' to remove a grant. ADMIN/SUPERADMIN, own-brand.",
        "operationId" : "revokeBroadcastAccess",
        "parameters" : [ {
          "name" : "accessType",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "userSubject",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
