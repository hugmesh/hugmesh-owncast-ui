      "get" : {
        "tags" : [ "Owncast Moderation" ],
        "summary" : "List the streams in the MODERATOR's brand (domain server-derived). Each row: ownerSubject, title, visibility, and whether the owner currently holds an active broadcast BAN (owncast_grant). MOD|ADMIN|SUPERADMIN.",
        "operationId" : "listModerationStreams",
        "responses" : {
          "200" : {
            "description" : "OK",
