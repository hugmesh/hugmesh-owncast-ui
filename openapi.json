                }
              }
            }
          }
        }
      }
    },
    "/bff/owncast/admin/access/ban" : {
      "post" : {
        "tags" : [ "Owncast Broadcast Access" ],
        "summary" : "BAN a USER from broadcast permanently (an active banned override, expires_at NULL). Denies even an active grantee (ban>grant). ADMIN/SUPERADMIN, own-brand.",
        "operationId" : "banBroadcast",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GrantOrBan"
              }
            }
          },
