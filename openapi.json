      "get" : {
        "tags" : [ "Owncast Broadcast Access" ],
        "summary" : "The full grant/timeout/ban HISTORY (active + revoked = audit) for a principal (scoped to the caller's brand; SUPERADMIN sees all). SUPERADMIN.",
        "operationId" : "broadcastAccessHistory",
        "parameters" : [ {
